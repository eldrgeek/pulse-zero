#!/usr/bin/env python3
"""pulse-push — push/list/bounce/resolve cards on the Pulse Zero board (manage-Mike surface).

Usage:
  pulse-push action   --title T [--why W] [--steps S] [--url U] [--source S]
                       [--actions JSON_OR_PATH]
                       [--yeshie-steps STEPS] [--yeshie-task JSON_OR_PATH]
  pulse-push verdict  --artifact A --url U --summary S
  pulse-push decision --question Q --options "A,B,C"
  pulse-push brief    --title T --lines L
  pulse-push bounce   --id ID --reason "..."
  pulse-push resolve  --id ID --note "..."
  pulse-push comment  --id ID --body "..." [--author mike]
  pulse-push --list-open
  pulse-push --list-answers [--since ISO8601]
  pulse-push --list-bounced
  pulse-push --list-snoozed
  pulse-push --list-comments [--source S]

Snooze (columns: pulse_cards.snoozed_until). A snoozed card is still
`status='open'` — snoozing is a visibility window, not a status — but is
hidden from the default board view until snoozed_until passes. Re-pushing a
snoozed card with the same --key does NOT wake it unless the payload is
genuinely different from what's already on the card (title/why/steps/url
changed, or yeshie fields changed): identical re-pushes leave it snoozed,
changed content clears snoozed_until so Mike sees the new information now.

Comments (table: pulse_card_comments, FK card_id -> pulse_cards.id).
Commenting never changes a card's status. The session-facing command to
collect Mike's comments on cards you pushed:

    bin/pulse-push --list-comments --source <the --source you used to push>

`--list-answers` also continues to mirror cards into SOMA/board/inbox/
(now including a `comments` array per card) for the passive-file pickup
path that already existed for answered/bounced/resolved cards.

Card contract (action cards): one imperative line, <=60 chars, a clickable
--url is strongly encouraged. See ~/Projects/_estate/specs/tower-steward-v0.md
and pulse-zero/README.md for the board standard.

Env:
  PULSE_ZERO_SUPABASE_URL   (default: https://omfwcodoimjmbrhssvfl.supabase.co)
  PULSE_ZERO_SERVICE_KEY    (required — Supabase service_role key, server-only)
"""
import argparse
import json
import os
import re
import sys
import urllib.parse
import urllib.request

# The card contract lives beside this script as an importable module so the
# other writer to this board (_estate/bin/pulse-enqueue) enforces the identical
# rules instead of being an unvalidated side door. Insert explicitly: this file
# is also loaded via runpy.run_path() by test/test_pulse_push_actions.py, which
# does not put the script's directory on sys.path.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from pulse_card_contract import CardContractError, validate_payload  # noqa: E402

DEFAULT_URL = "https://omfwcodoimjmbrhssvfl.supabase.co"
APP_ID = "pulse-zero"
BOARD_INBOX = os.path.expanduser("~/Projects/SOMA/board/inbox")
STEP_ACTION_COMMANDS = {
    "open_url",
    "open_session",
    "clipboard_set",
    "clipboard_take_and_deploy",
}
CARD_ACTIONS_VERSION = 1
CARD_ACTION_EXECUTORS = {"workflow", "web", "mac"}
ACTION_ID_RE = re.compile(r"^[a-z][a-z0-9-]{0,63}$")
TARGET_REF_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_.:-]{0,127}$")
QUEUE_GATE_KINDS = {"authentication", "consent", "money", "judgment"}
QUEUE_CONTINUATION_VERIFIERS = {"owner_acknowledged", "external_state", "artifact_state"}
QUEUE_SUPPORTED_OPERATIONS = {
    ("workflow", "gdoc_bridge_authorize"): {
        "verification": "google_drive_about",
        "target_ref": "google.oauth.consent.primary",
        "target_host": "accounts.google.com",
    },
    ("workflow", "github_accept_org_invite"): {
        "verification": "github_org_membership",
        "target_ref": "github.org_invitation.accept",
        "target_host": "github.com",
    },
}


def sb_request(method, path, key, url, body=None, params=None):
    full = f"{url}/rest/v1/{path}"
    if params:
        full += "?" + "&".join(f"{k}={urllib.parse.quote(str(v), safe='')}" for k, v in params.items())
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(full, data=data, method=method)
    req.add_header("apikey", key)
    req.add_header("Authorization", f"Bearer {key}")
    req.add_header("Content-Type", "application/json")
    if method in ("POST", "PATCH"):
        req.add_header("Prefer", "return=representation")
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read().decode() or "null")
    except urllib.error.HTTPError as e:
        sys.stderr.write(f"HTTP {e.code}: {e.read().decode()}\n")
        sys.exit(1)


def enforce_contract(card_type, payload):
    """Run the shared card contract over the payload that is about to be
    written. Hard violations exit non-zero naming the rule and the board
    standard; soft issues go to stderr as warnings and the push continues.

    The rules themselves live in pulse_card_contract so _estate/bin/pulse-enqueue
    enforces exactly the same ones at enqueue time."""
    try:
        warnings = validate_payload(card_type, payload)
    except CardContractError as e:
        sys.stderr.write(f"error: {e}\n")
        sys.exit(1)
    for w in warnings:
        sys.stderr.write(f"warn: {w}\n")


def parse_step_actions(raw, steps):
    """Validate the family-facing step-action contract before it reaches the
    board. This keeps a malformed producer payload from breaking card render
    or turning an unknown command into a misleading Run button."""
    try:
        actions = json.loads(raw)
    except json.JSONDecodeError as e:
        sys.stderr.write(f"error: --step-actions is not valid JSON: {e}\n")
        sys.exit(1)
    if not isinstance(actions, list):
        sys.stderr.write("error: --step-actions must be a JSON array\n")
        sys.exit(1)
    step_count = len([line for line in (steps or "").splitlines() if line.strip()])
    if len(actions) > step_count:
        sys.stderr.write(
            f"error: --step-actions has {len(actions)} entries but --steps has "
            f"only {step_count} non-empty lines\n"
        )
        sys.exit(1)
    for idx, action in enumerate(actions):
        if action is None:
            continue
        if not isinstance(action, dict):
            sys.stderr.write(f"error: --step-actions[{idx}] must be null or an object\n")
            sys.exit(1)
        command = action.get("command")
        if command not in STEP_ACTION_COMMANDS:
            sys.stderr.write(
                f"error: --step-actions[{idx}].command must be one of "
                f"{', '.join(sorted(STEP_ACTION_COMMANDS))}\n"
            )
            sys.exit(1)
        if not isinstance(action.get("payload", {}), dict):
            sys.stderr.write(f"error: --step-actions[{idx}].payload must be an object\n")
            sys.exit(1)
        if command == "open_url":
            url = action.get("payload", {}).get("url")
            parsed = urllib.parse.urlparse(url or "")
            if parsed.scheme not in ("https", "http") or not parsed.netloc:
                sys.stderr.write(
                    f"error: --step-actions[{idx}] open_url requires an "
                    "absolute http(s) payload.url\n"
                )
                sys.exit(1)
        for text_field in ("label", "success_message"):
            if text_field in action and not isinstance(action[text_field], str):
                sys.stderr.write(
                    f"error: --step-actions[{idx}].{text_field} must be a string\n"
                )
                sys.exit(1)
    return actions


def validate_card_actions(actions):
    """Validate payload.actions v1 without side effects.

    The executor receives this object verbatim, so authoring fails closed:
    every request has a stable id/revision, a named executor, an explicit
    verification contract, and (when needed) an exact Yeshie human-gate
    target. Raises ValueError with an author-facing message.
    """
    if not isinstance(actions, list) or not actions:
        raise ValueError("--actions must be a non-empty JSON array")
    seen = set()
    for idx, action in enumerate(actions):
        at = f"--actions[{idx}]"
        if not isinstance(action, dict):
            raise ValueError(f"{at} must be an object")
        action_id = action.get("id")
        if not isinstance(action_id, str) or not ACTION_ID_RE.fullmatch(action_id):
            raise ValueError(f"{at}.id must be a lowercase slug (letters, numbers, hyphens)")
        if action_id in seen:
            raise ValueError(f"{at}.id duplicates {action_id!r}")
        seen.add(action_id)
        revision = action.get("revision")
        if isinstance(revision, bool) or not isinstance(revision, int) or revision < 1:
            raise ValueError(f"{at}.revision must be a positive integer")
        executor = action.get("executor")
        if executor not in CARD_ACTION_EXECUTORS:
            raise ValueError(f"{at}.executor must be workflow, web, or mac")
        for field in ("label", "operation"):
            if not isinstance(action.get(field), str) or not action[field].strip():
                raise ValueError(f"{at}.{field} is required")
        if "description" in action and (
                not isinstance(action["description"], str) or not action["description"].strip()):
            raise ValueError(f"{at}.description must be a non-empty string when present")
        if not isinstance(action.get("params"), dict):
            raise ValueError(f"{at}.params must be an object")

        completion = action.get("completion")
        if not isinstance(completion, dict) or completion.get("mode") != "verified":
            raise ValueError(f"{at}.completion.mode must be verified")
        if not isinstance(completion.get("success_message"), str) or not completion["success_message"].strip():
            raise ValueError(f"{at}.completion.success_message is required")
        if "close_card" in completion and not isinstance(completion["close_card"], bool):
            raise ValueError(f"{at}.completion.close_card must be a boolean when present")

        verification = action.get("verification")
        if not isinstance(verification, dict) or (
                not isinstance(verification.get("kind"), str) or not verification["kind"].strip()):
            raise ValueError(f"{at}.verification.kind is required")
        if "params" in verification and not isinstance(verification["params"], dict):
            raise ValueError(f"{at}.verification.params must be an object when present")

        if "human_gate" in action:
            if executor not in {"workflow", "web"}:
                raise ValueError(f"{at}.human_gate is only valid for workflow or web executors")
            gate = action["human_gate"]
            if not isinstance(gate, dict) or (
                    not isinstance(gate.get("instruction"), str) or not gate["instruction"].strip()):
                raise ValueError(f"{at}.human_gate.instruction is required")
            target = gate.get("target") if isinstance(gate, dict) else None
            if not isinstance(target, dict):
                raise ValueError(f"{at}.human_gate.target must be an object")
            parsed = urllib.parse.urlparse(target.get("url") or "")
            if parsed.scheme != "https" or not parsed.netloc:
                raise ValueError(f"{at}.human_gate.target.url must be an absolute https URL")
            if not isinstance(target.get("ref"), str) or not TARGET_REF_RE.fullmatch(target["ref"]):
                raise ValueError(f"{at}.human_gate.target.ref must name a Yeshie abstract target")
            if not isinstance(target.get("label"), str) or not target["label"].strip():
                raise ValueError(f"{at}.human_gate.target.label is required")
    return actions


def parse_card_actions(raw):
    candidate = os.path.expanduser(raw)
    try:
        if os.path.isfile(candidate):
            with open(candidate) as f:
                actions = json.load(f)
        else:
            actions = json.loads(raw)
        return validate_card_actions(actions)
    except (json.JSONDecodeError, OSError, ValueError) as e:
        sys.stderr.write(f"error: {e}\n")
        sys.exit(1)


def parse_json_object(raw, flag_name):
    candidate = os.path.expanduser(raw or "")
    try:
        if os.path.isfile(candidate):
            with open(candidate) as f:
                value = json.load(f)
        else:
            value = json.loads(raw)
    except (json.JSONDecodeError, OSError, TypeError) as e:
        raise ValueError(f"{flag_name} is not valid JSON: {e}") from e
    if not isinstance(value, dict):
        raise ValueError(f"{flag_name} must be a JSON object")
    return value


def validate_queue_contract(card_type, payload, gate, continuation, dedupe_key,
                            priority_band, priority_reason, blocked_work_count,
                            yeshie_task=None):
    """Fail closed for cards explicitly opting into queue v1.

    Legacy producers remain readable and keep queue_state=legacy. A producer
    asking for queue eligibility must supply a stable decision unit, one of the
    four real Mike gates, a return-to-owner contract, deterministic priority,
    and either a reviewed typed operation or a direct Pulse judgment.
    """
    if not dedupe_key:
        raise ValueError("--queue-v1 requires --key for duplicate stewardship")
    if not isinstance(priority_band, int) or isinstance(priority_band, bool) or not 0 <= priority_band <= 3:
        raise ValueError("--queue-v1 requires --priority-band 0..3")
    if not isinstance(priority_reason, str) or not priority_reason.strip():
        raise ValueError("--queue-v1 requires --priority-reason")
    if not isinstance(blocked_work_count, int) or isinstance(blocked_work_count, bool) or blocked_work_count < 0:
        raise ValueError("--blocked-work-count must be a non-negative integer")

    if gate.get("version") != 1 or gate.get("kind") not in QUEUE_GATE_KINDS:
        raise ValueError("--gate-contract requires version=1 and kind authentication|consent|money|judgment")
    if not isinstance(gate.get("reason_only_mike"), str) or not gate["reason_only_mike"].strip():
        raise ValueError("--gate-contract.reason_only_mike is required")
    estimate = gate.get("estimated_human_seconds")
    if not isinstance(estimate, int) or isinstance(estimate, bool) or estimate < 1:
        raise ValueError("--gate-contract.estimated_human_seconds must be a positive integer")
    target = gate.get("target")
    if not isinstance(target, dict) or target.get("surface") not in {"pulse", "web"}:
        raise ValueError("--gate-contract.target.surface must be pulse or web")
    if not isinstance(target.get("label"), str) or not target["label"].strip():
        raise ValueError("--gate-contract.target.label is required")
    if target["surface"] == "web":
        parsed = urllib.parse.urlparse(target.get("url") or "")
        if parsed.scheme != "https" or not parsed.netloc or not target.get("ref"):
            raise ValueError("web queue gates require an HTTPS target.url and abstract target.ref")
    if gate["kind"] == "money":
        money = gate.get("money")
        if not isinstance(money, dict) or not all(k in money for k in (
                "amount", "currency", "payee", "maximum_authorized_amount")):
            raise ValueError("money gates require amount, currency, payee, and maximum_authorized_amount")
        if (not isinstance(money["amount"], (int, float)) or isinstance(money["amount"], bool) or
                money["amount"] < 0 or
                not isinstance(money["maximum_authorized_amount"], (int, float)) or
                isinstance(money["maximum_authorized_amount"], bool) or
                money["maximum_authorized_amount"] < money["amount"] or
                not isinstance(money["currency"], str) or not re.fullmatch(r"[A-Z]{3}", money["currency"]) or
                not isinstance(money["payee"], str) or not money["payee"].strip()):
            raise ValueError("money gate terms are invalid")

    if continuation.get("version") != 1 or continuation.get("operation") != "resume_card_owner":
        raise ValueError("--continuation-contract requires version=1 and operation=resume_card_owner")
    if continuation.get("trigger") not in {"gate_answered", "actions_verified"}:
        raise ValueError("--continuation-contract.trigger must be gate_answered or actions_verified")
    for field in ("owner_ref", "correlation_key", "success_message"):
        if not isinstance(continuation.get(field), str) or not continuation[field].strip():
            raise ValueError(f"--continuation-contract.{field} is required")
    verifier = continuation.get("verification")
    if not isinstance(verifier, dict) or verifier.get("kind") not in QUEUE_CONTINUATION_VERIFIERS:
        raise ValueError("--continuation-contract.verification.kind is not supported")

    if card_type == "action":
        if yeshie_task is not None:
            raise ValueError("queued cards cannot rely on legacy --yeshie-task")
        actions = payload.get("actions")
        if payload.get("actions_version") != 1 or not isinstance(actions, list) or not actions:
            raise ValueError("queued action cards require --actions typed contract v1")
        if continuation["trigger"] != "actions_verified":
            raise ValueError("queued action continuations must trigger on actions_verified")
        for action in actions:
            spec = QUEUE_SUPPORTED_OPERATIONS.get((action.get("executor"), action.get("operation")))
            if not spec:
                raise ValueError(
                    f"queued action operation is not reviewed: {action.get('executor')}/{action.get('operation')}"
                )
            action_target = (action.get("human_gate") or {}).get("target") or {}
            parsed = urllib.parse.urlparse(action_target.get("url") or "")
            if action_target.get("ref") != spec["target_ref"] or parsed.hostname != spec["target_host"]:
                raise ValueError("queued action human-gate target is not reviewed")
            if (action.get("verification") or {}).get("kind") != spec["verification"]:
                raise ValueError("queued action verification is not reviewed")
            if action.get("operation") == "github_accept_org_invite":
                params = action.get("params") or {}
                github_name = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$")
                if set(params) != {"org", "username"} or not all(
                        isinstance(params.get(key), str) and github_name.fullmatch(params[key])
                        for key in ("org", "username")):
                    raise ValueError("GitHub queue action requires strict params.org + params.username")
                if parsed.path.rstrip("/") != f"/orgs/{params['org']}/invitation":
                    raise ValueError("GitHub queue action requires the exact organization invitation URL")
            if target.get("ref") != action_target.get("ref") or target.get("label") != action_target.get("label"):
                raise ValueError("queue gate target must match the typed action human gate")
    elif card_type in {"decision", "verdict"}:
        if gate["kind"] != "judgment" or target["surface"] != "pulse":
            raise ValueError("queued decision/verdict cards require a judgment gate on the Pulse surface")
        if continuation["trigger"] != "gate_answered":
            raise ValueError("queued decision/verdict continuations must trigger on gate_answered")
        if card_type == "decision" and len(payload.get("options") or []) < 2:
            raise ValueError("queued decisions require at least two explicit options")
    else:
        raise ValueError(f"{card_type} cards cannot enter queue v1")


def apply_queue_authoring(row, args, card_type):
    queue_fields = (
        "gate_contract", "continuation_contract", "priority_band",
        "priority_reason", "deadline_at", "mission_lane",
    )
    requested = bool(getattr(args, "queue_v1", False))
    supplied = any(getattr(args, field, None) is not None for field in queue_fields) or \
        getattr(args, "blocked_work_count", 1) != 1
    if supplied and not requested:
        raise ValueError("queue contract fields require --queue-v1")
    if not requested:
        return
    gate = parse_json_object(getattr(args, "gate_contract", None), "--gate-contract")
    continuation = parse_json_object(
        getattr(args, "continuation_contract", None), "--continuation-contract"
    )
    validate_queue_contract(
        card_type,
        row["payload"],
        gate,
        continuation,
        row.get("dedupe_key"),
        getattr(args, "priority_band", None),
        getattr(args, "priority_reason", None),
        getattr(args, "blocked_work_count", 1),
        row.get("yeshie_task"),
    )
    row.update({
        "contract_version": 1,
        "gate_contract": gate,
        "continuation_contract": continuation,
        "queue_state": "intake",
        "priority_band": args.priority_band,
        "priority_reason": args.priority_reason.strip(),
        "blocked_work_count": args.blocked_work_count,
    })
    if args.deadline_at:
        row["deadline_at"] = args.deadline_at
    if args.mission_lane:
        row["mission_lane"] = args.mission_lane


def validate_action_revision_change(old_payload, new_payload):
    """A stable id+revision is an immutable idempotency boundary.

    A deduped re-push may edit prose freely, but changing an action definition
    under the same revision would cause a previous verified receipt to certify
    new behavior. Reject that and require an explicit revision bump.
    """
    old_actions = {
        action.get("id"): action
        for action in (old_payload or {}).get("actions", [])
        if isinstance(action, dict) and action.get("id")
    }
    new_actions = {
        action.get("id"): action
        for action in (new_payload or {}).get("actions", [])
        if isinstance(action, dict) and action.get("id")
    }
    removed = sorted(set(old_actions) - set(new_actions))
    if removed:
        raise ValueError(
            "deduped re-push would remove typed action(s) "
            f"{', '.join(repr(action_id) for action_id in removed)}; "
            "re-pass the complete --actions contract or resolve and issue a new card"
        )
    for action in new_actions.values():
        old = old_actions.get(action.get("id"))
        if not old:
            continue
        old_revision = old.get("revision")
        new_revision = action.get("revision")
        if isinstance(old_revision, int) and new_revision < old_revision:
            raise ValueError(
                f"action {action['id']!r} revision moved backwards "
                f"({old_revision} -> {new_revision})"
            )
        if new_revision == old_revision and action != old:
            raise ValueError(
                f"action {action['id']!r} changed without a revision bump "
                f"(still revision {new_revision})"
            )


def push(args, key, url):
    payload = {}
    ctype = args.type
    if ctype == "action":
        payload = {"title": args.title, "why": args.why or "", "steps": args.steps, "url": args.url}
        step_actions_raw = getattr(args, "step_actions", None)
        card_actions_raw = getattr(args, "actions", None)
        if step_actions_raw and card_actions_raw:
            sys.stderr.write(
                "error: use --actions for the typed v1 contract or --step-actions "
                "for a legacy card, not both\n"
            )
            sys.exit(1)
        if step_actions_raw:
            payload["step_actions"] = parse_step_actions(step_actions_raw, args.steps)
        if card_actions_raw:
            payload["actions_version"] = CARD_ACTIONS_VERSION
            payload["actions"] = parse_card_actions(card_actions_raw)
    elif ctype == "verdict":
        payload = {"artifact_name": args.artifact, "url": args.url, "summary": args.summary}
    elif ctype == "decision":
        payload = {
            "question": args.question,
            "options": [o.strip() for o in (args.options or "").split(",") if o.strip()],
        }
        # --why / --url (2026-07-29): a decision card used to carry the question and
        # nothing else, so Mike had to ask the posting session for context and wait on
        # the round trip. Both fields are optional and additive; older cards without
        # them render exactly as before.
        if getattr(args, "why", None):
            payload["why"] = args.why
        if getattr(args, "url", None):
            payload["url"] = args.url
    elif ctype == "brief":
        payload = {"title": args.title, "lines": args.lines}
        # --full-text (2026-08-13): the complete fleet-record body, rendered
        # collapsed-by-default behind a drill-down. --lines stays the short,
        # always-visible digest (~2-second scan) — see README "Board
        # standard" and SOMA/pulse/USEFULNESS-2026-08-11.md's modality map
        # ("Brief/FYI: 3-line digest ... md file = fleet record").
        if getattr(args, "full_text", None):
            payload["full_text"] = args.full_text

    # One enforcement point, shared with _estate/bin/pulse-enqueue.
    enforce_contract(ctype, payload)

    dedupe_key = getattr(args, "key", None)
    source = args.source or "unknown"

    row = {
        "app_id": APP_ID,
        "type": ctype,
        "payload": payload,
        "created_by": source,
        "status": "open",
    }
    if dedupe_key:
        row["dedupe_key"] = dedupe_key
    if ctype == "action":
        if getattr(args, "yeshie_steps", None):
            row["yeshie_steps"] = args.yeshie_steps
        yt = getattr(args, "yeshie_task", None)
        if yt:
            row["yeshie_task"] = load_yeshie_task(yt)

    try:
        apply_queue_authoring(row, args, ctype)
    except ValueError as e:
        sys.stderr.write(f"error: {e}\n")
        sys.exit(1)

    # ── Dedup path 1: explicit --key. Mirrors pulse-enqueue's "replace same
    # key" semantics — an OPEN card with the same dedupe_key gets updated in
    # place instead of a new row being inserted.
    if dedupe_key:
        existing = sb_request(
            "GET", "pulse_cards", key, url,
            params={"app_id": f"eq.{APP_ID}", "status": "eq.open", "dedupe_key": f"eq.{dedupe_key}", "limit": "1"},
        )
        if existing:
            existing_card = existing[0]
            card_id = existing_card["id"]
            try:
                validate_action_revision_change(existing_card.get("payload"), row.get("payload"))
            except ValueError as e:
                sys.stderr.write(f"error: {e}\n")
                sys.exit(1)
            patch_body = {k: v for k, v in row.items() if k not in ("app_id", "status")}
            if ctype == "action":
                old_steps = (existing_card.get("payload") or {}).get("steps")
                new_steps = (row.get("payload") or {}).get("steps")
                if old_steps != new_steps:
                    # step_state is index-aligned. Keeping old checks after a
                    # rewritten checklist silently marks unrelated new work
                    # complete, so reset it whenever the step text changes.
                    patch_body["step_state"] = {}

            # Snooze-aware re-push: a snoozed card re-pushed with the same
            # --key should NOT jump back into view just because a session
            # retried/re-ran a job, but genuinely new information (payload,
            # yeshie steps/task changed) should still surface now. Compare
            # only the content fields, not bookkeeping (dedupe_key itself).
            snoozed_until = existing_card.get("snoozed_until")
            is_snoozed = bool(snoozed_until) and _parse_iso(snoozed_until) > _now_dt()
            if is_snoozed:
                content_keys = ("payload", "yeshie_steps", "yeshie_task")
                same_content = all(
                    existing_card.get(k) == row.get(k) for k in content_keys if k in row or k in existing_card
                )
                if same_content:
                    print(
                        f"card {card_id} is snoozed until {snoozed_until}; re-push carried no new "
                        f"information — leaving it snoozed (key={dedupe_key})"
                    )
                    return existing_card
                else:
                    patch_body["snoozed_until"] = None
                    result = sb_request("PATCH", "pulse_cards", key, url, body=patch_body, params={"id": f"eq.{card_id}"})
                    card = result[0] if isinstance(result, list) else result
                    print(
                        f"card {card_id} had new information on re-push — woke it from snooze "
                        f"(was until {snoozed_until}, key={dedupe_key})"
                    )
                    return card

            result = sb_request("PATCH", "pulse_cards", key, url, body=patch_body, params={"id": f"eq.{card_id}"})
            card = result[0] if isinstance(result, list) else result
            print(f"updated existing {ctype} card {card.get('id')} (key={dedupe_key})")
            return card

    # ── Dedup path 2: safety net for action cards pushed without --key.
    # Multiple sessions/Tower pushing near-identical cards is the more likely
    # real-world duplicate cause; skip (don't insert) and warn on stderr
    # rather than silently duplicating.
    if ctype == "action" and not dedupe_key:
        dup = find_duplicate_action(source, args.title, key, url)
        if dup:
            sys.stderr.write(
                f"warn: skipping insert — an OPEN action card with the same title+source "
                f"already exists: {dup.get('id')} (title={args.title!r}, source={source!r}).\n"
                f"  Use --key on anything a session might push more than once.\n"
            )
            print(f"skipped duplicate; existing card {dup.get('id')}")
            return dup

    result = sb_request("POST", "pulse_cards", key, url, body=row)
    card = result[0] if isinstance(result, list) else result
    print(f"pushed {ctype} card {card.get('id')}")
    return card


def find_duplicate_action(source, title, key, url):
    """Case-insensitive title match among this source's OPEN action cards.
    Client-side compare (not a payload->>title filter) to avoid PostgREST
    jsonb-path URL-encoding edge cases."""
    if not title:
        return None
    rows = sb_request(
        "GET", "pulse_cards", key, url,
        params={"app_id": f"eq.{APP_ID}", "status": "eq.open", "type": "eq.action",
                "created_by": f"eq.{source}", "limit": "50"},
    )
    norm = title.strip().lower()
    for r in rows or []:
        existing_title = (r.get("payload") or {}).get("title", "")
        if existing_title.strip().lower() == norm:
            return r
    return None


def load_yeshie_task(value):
    """--yeshie-task accepts either inline JSON or a path to a recipe/payload
    JSON file (e.g. yeshie/sites/<domain>/tasks/*.payload.json)."""
    candidate = os.path.expanduser(value)
    if os.path.isfile(candidate):
        with open(candidate) as f:
            try:
                return json.load(f)
            except json.JSONDecodeError:
                # not JSON — treat as a bare recipe reference
                return {"recipe_path": candidate}
    try:
        return json.loads(value)
    except json.JSONDecodeError:
        # bare string reference, e.g. "sites/github.com/tasks/foo.payload.json"
        return {"recipe_path": value}


def list_cards(status_filter, key, url, since=None, snoozed_only=False, print_json=True):
    params = {"app_id": f"eq.{APP_ID}", "order": "created_at.desc", "limit": "200"}
    if status_filter:
        params["status"] = f"eq.{status_filter}"
    if since:
        params["answered_at"] = f"gte.{since}"
    if snoozed_only:
        params["status"] = "eq.open"
        params["snoozed_until"] = f"gt.{_now_iso()}"
    rows = sb_request("GET", "pulse_cards", key, url, params=params)
    if print_json:
        print(json.dumps(rows, indent=2))
    return rows


def fetch_comments_by_card(card_ids, key, url):
    """One batched GET for all comments across the given card ids, grouped
    by card_id. Avoids N+1 requests when syncing/listing many cards."""
    by_card = {cid: [] for cid in card_ids}
    if not card_ids:
        return by_card
    id_list = ",".join(card_ids)
    rows = sb_request(
        "GET", "pulse_card_comments", key, url,
        params={"card_id": f"in.({id_list})", "order": "created_at.asc", "limit": "1000"},
    )
    for c in rows or []:
        by_card.setdefault(c["card_id"], []).append(c)
    return by_card


def comment(args, key, url):
    if not args.body or not args.body.strip():
        sys.stderr.write("error: --body is required for comment\n")
        sys.exit(1)
    existing = sb_request(
        "GET", "pulse_cards", key, url,
        params={"id": f"eq.{args.id}", "limit": "1"},
    )
    if not existing:
        sys.stderr.write(f"error: no card matched id {args.id}\n")
        sys.exit(1)
    row = {"card_id": args.id, "author": args.author or "mike", "body": args.body}
    result = sb_request("POST", "pulse_card_comments", key, url, body=row)
    c = result[0] if isinstance(result, list) else result
    print(f"commented on card {args.id}: {c.get('id')}")
    return c


def sync_answers_to_board(rows, key, url):
    """Mirror cards into SOMA/board/inbox/ for the passive-file pickup path.
    A card is synced if it's no longer open (answered/bounced/resolved/
    retired) OR it has at least one comment — commenting never changes
    status, so an open card can still have new information a session needs
    to see. Unlike the original answered-only version, this always
    (re)writes the file rather than skipping when it already exists, since a
    comment can land on a card *after* it was first synced (e.g. after it
    was already answered) and the session needs the updated comment list on
    its next poll."""
    os.makedirs(BOARD_INBOX, exist_ok=True)
    comments_by_card = fetch_comments_by_card([r["id"] for r in rows], key, url)
    synced = 0
    for r in rows:
        comments = comments_by_card.get(r["id"], [])
        if r.get("status") == "open" and not comments:
            continue
        card_file = os.path.join(BOARD_INBOX, f"pulse-zero-{r['id']}.json")
        with open(card_file, "w") as f:
            json.dump({
                "source": "pulse-zero",
                "card_id": r["id"],
                "type": r["type"],
                "created_by": r.get("created_by"),
                "payload": r["payload"],
                "status": r["status"],
                "answer": r.get("answer"),
                "answered_at": r.get("answered_at"),
                "comments": comments,
            }, f, indent=2)
        synced += 1
    print(f"synced {synced} card(s) to {BOARD_INBOX}", file=sys.stderr)


def list_comments(args, key, url):
    """Session-facing command: `pulse-push --list-comments --source <src>`.
    Prints (JSON) every card from that source that has at least one
    comment, each with its comments embedded — this is the exact command a
    session should run to collect Mike's comments on cards it pushed."""
    params = {"app_id": f"eq.{APP_ID}", "order": "created_at.desc", "limit": "200"}
    if getattr(args, "source", None):
        params["created_by"] = f"eq.{args.source}"
    rows = sb_request("GET", "pulse_cards", key, url, params=params)
    comments_by_card = fetch_comments_by_card([r["id"] for r in rows or []], key, url)
    out = []
    for r in rows or []:
        cs = comments_by_card.get(r["id"], [])
        if not cs:
            continue
        r = dict(r)
        r["comments"] = cs
        out.append(r)
    print(json.dumps(out, indent=2))
    return out


def bounce(args, key, url):
    if not args.reason or not args.reason.strip():
        sys.stderr.write("error: --reason is required for bounce\n")
        sys.exit(1)
    body = {"status": "bounced", "bounce_reason": args.reason, "answered_at": _now_iso()}
    result = sb_request("PATCH", "pulse_cards", key, url, body=body, params={"id": f"eq.{args.id}"})
    if not result:
        sys.stderr.write(f"error: no card matched id {args.id}\n")
        sys.exit(1)
    print(f"bounced card {args.id}: {args.reason}")
    print('You know what to do, don\'t you?')
    return result


def resolve(args, key, url):
    if not args.note or not args.note.strip():
        sys.stderr.write("error: --note is required for resolve\n")
        sys.exit(1)
    body = {"status": "resolved", "resolved_note": args.note, "answered_at": _now_iso()}
    result = sb_request("PATCH", "pulse_cards", key, url, body=body, params={"id": f"eq.{args.id}"})
    if not result:
        sys.stderr.write(f"error: no card matched id {args.id}\n")
        sys.exit(1)
    print(f"resolved card {args.id}: {args.note}")
    return result


def _now_iso():
    import datetime
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def _now_dt():
    import datetime
    return datetime.datetime.now(datetime.timezone.utc)


def _parse_iso(s):
    import datetime
    return datetime.datetime.fromisoformat(s.replace("Z", "+00:00"))


def add_queue_args(parser):
    parser.add_argument(
        "--queue-v1", action="store_true",
        help="opt this card into the executable queue intake (requires the additive queue migration)",
    )
    parser.add_argument("--gate-contract", help="gate contract v1 JSON object or path")
    parser.add_argument("--continuation-contract", help="continuation contract v1 JSON object or path")
    parser.add_argument("--priority-band", type=int, choices=range(4))
    parser.add_argument("--priority-reason", help="why this blocks active work now")
    parser.add_argument("--deadline-at", help="optional ISO-8601 deadline; rank uses it after priority band")
    parser.add_argument("--blocked-work-count", type=int, default=1)
    parser.add_argument("--mission-lane", help="Legends, Playmaker, SOMA, or another stable lane")


def main():
    p = argparse.ArgumentParser(description="Push/list/bounce/resolve cards on Pulse Zero")
    sub = p.add_subparsers(dest="type")

    a = sub.add_parser("action")
    a.add_argument("--title", required=True)
    a.add_argument("--why")
    a.add_argument("--steps")
    a.add_argument("--url")
    a.add_argument("--source")
    a.add_argument("--key", help="stable dedup key — replaces any existing OPEN card with the same key instead of inserting a new one")
    a.add_argument("--yeshie-steps", dest="yeshie_steps",
                    help="newline-separated human steps rendered as an overlay checklist ('Guide me')")
    a.add_argument("--actions",
                    help="payload.actions v1 JSON array or path to a JSON file. Each Mike-requested "
                         "operation must be a typed {id,revision,executor,label,operation,params,"
                         "completion,verification,human_gate?} action. Routes through the durable "
                         "execute_card_action Mac-command envelope.")
    a.add_argument("--step-actions", dest="step_actions",
                    help="LEGACY: JSON array, index-aligned with --steps lines (0-based), each entry either "
                         "null or {\"command\": \"open_url|open_session|clipboard_set|clipboard_take_and_deploy\", "
                         "\"payload\": {...}} per pulse-mac-bridge/CONTRACT.md. Renders a real button on "
                         "that step in the board UI. See public/index.html STEP_ACTIONS_CONVENTION comment.")
    a.add_argument("--yeshie-task", dest="yeshie_task",
                    help="inline JSON or path to a Yeshie recipe/payload.json ('do it while I watch')")
    add_queue_args(a)

    v = sub.add_parser("verdict")
    v.add_argument("--artifact", required=True)
    v.add_argument("--url", required=True)
    v.add_argument("--summary", required=True)
    v.add_argument("--source")
    v.add_argument("--key", help="stable dedup key — replaces any existing OPEN card with the same key instead of inserting a new one")
    add_queue_args(v)

    d = sub.add_parser("decision")
    d.add_argument("--question", required=True)
    d.add_argument("--options", required=True, help="comma-separated, max 4")
    d.add_argument("--why", help="context shown on the card, so Mike can decide without asking the poster")
    d.add_argument("--url", help="deep link to the full writeup — the fast route to more info")
    d.add_argument("--source")
    d.add_argument("--key", help="stable dedup key — replaces any existing OPEN card with the same key instead of inserting a new one")
    add_queue_args(d)

    b = sub.add_parser("brief")
    b.add_argument("--title", required=True)
    b.add_argument("--lines", required=True, help="short, always-visible digest (~2-second scan)")
    b.add_argument("--full-text", dest="full_text", help="optional: full body, rendered collapsed behind a drill-down")
    b.add_argument("--source")
    b.add_argument("--key", help="stable dedup key — replaces any existing OPEN card with the same key instead of inserting a new one")

    bo = sub.add_parser("bounce")
    bo.add_argument("--id", required=True)
    bo.add_argument("--reason", required=True)

    rs = sub.add_parser("resolve")
    rs.add_argument("--id", required=True)
    rs.add_argument("--note", required=True)

    cm = sub.add_parser("comment")
    cm.add_argument("--id", required=True)
    cm.add_argument("--body", required=True)
    cm.add_argument("--author", default="mike", help="default 'mike' — this is normally added via the board UI")

    p.add_argument("--list-open", action="store_true")
    p.add_argument("--list-answers", action="store_true")
    p.add_argument("--list-bounced", action="store_true")
    p.add_argument("--list-snoozed", action="store_true", help="cards currently open but hidden from the default view until snoozed_until passes")
    p.add_argument("--list-comments", action="store_true", help="session-facing: cards (optionally filtered by --source) that have comments, with comments embedded")
    p.add_argument("--source", help="filter for --list-comments")
    p.add_argument("--since")

    args = p.parse_args()

    key = os.environ.get("PULSE_ZERO_SERVICE_KEY")
    url = os.environ.get("PULSE_ZERO_SUPABASE_URL", DEFAULT_URL)
    if not key:
        sys.stderr.write("PULSE_ZERO_SERVICE_KEY not set\n")
        sys.exit(1)

    if args.list_open:
        list_cards("open", key, url)
    elif args.list_bounced:
        list_cards("bounced", key, url)
    elif args.list_snoozed:
        list_cards(None, key, url, snoozed_only=True)
    elif args.list_comments:
        list_comments(args, key, url)
    elif args.list_answers:
        rows = list_cards(None, key, url, since=args.since)
        sync_answers_to_board(rows, key, url)
    elif args.type == "bounce":
        bounce(args, key, url)
    elif args.type == "resolve":
        resolve(args, key, url)
    elif args.type == "comment":
        comment(args, key, url)
    elif args.type:
        push(args, key, url)
    else:
        p.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
